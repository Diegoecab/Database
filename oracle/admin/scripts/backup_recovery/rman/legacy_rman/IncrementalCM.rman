# ------------------------------------------------------------------------------
# File       : IncrementalCM.rman
# Purpose    : Oracle RMAN backup, restore or recovery helper: IncrementalCM.
# Category   : backup_recovery/rman
# Author     : Diego Cabrera
# Created    : Unknown
# Version    : 1.0
# Usage      : rman target / cmdfile=IncrementalCM.rman
# Parameters : Review RMAN target/catalog connection and channels before running.
# Requires   : RMAN, Oracle environment, and required backup/recovery privileges.
# Oracle Ver.: Review compatibility before production use.
# Risk       : REVIEW
# Output     : RMAN console or log output.
# Notes      : Validate in a non-production session before operational use.
# Source     : internal
# Change Log : 
# 2026-05-11 : Diego Cabrera - Header normalization.
# ------------------------------------------------------------------------------
#
run {
crosscheck backup;	
delete noprompt obsolete;	
delete noprompt expired backup;
sql 'alter system archive log current';	}

run {	
     backup current controlfile format='D:\oracle\DBA\RMAN\CONTROLFILE%f.rman';
     backup as compressed backupset incremental level = 1 database format 'D:\oracle\DBA\RMAN\DBA%u_%d_%s_%t_incremental.rman';
#      include current controlfile plus archivelog
     }

run {	
     crosscheck backup;
     crosscheck archivelog all;	
     # Validando los logs archivados ...	
     change archivelog all validate;	
     #Backup de Archives
     sql 'alter system archive log current';	
     backup archivelog all delete input TAG=archivelogs format 'D:\oracle\DBA\RMAN\DBA_%e_ARCHIVES_INC.rman';
     # Archivos que necesitan Backup:	
     report need backup;
    }
	
exit	